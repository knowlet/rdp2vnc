+
+#[test]
+fn unaligned_subject_public_key_is_rejected_before_nla_binding() {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let public_key = leaf.signing_key.public_key_raw();
+    let aligned = BitString::from_bytes(public_key)
+        .expect("aligned key")
+        .to_der()
+        .expect("DER bit string");
+    let mut unaligned_key = public_key.to_vec();
+    *unaligned_key.last_mut().expect("nonempty public key") &= 0xfe;
+    let unaligned = BitString::new(1, unaligned_key)
+        .expect("unaligned key")
+        .to_der()
+        .expect("DER bit string");
+    let mut der = leaf.cert.der().to_vec();
+    let offset = der
+        .windows(aligned.len())
+        .position(|bytes| bytes == aligned)
+        .expect("find subject public key");
+    der[offset..offset + aligned.len()].copy_from_slice(&unaligned);
+    // Keep this a valid DER/X.509 structure so the alignment check, not the parser, rejects it.
+    x509_cert::Certificate::from_der(&der).expect("structurally valid X.509 certificate");
+    let files = IdentityFiles::new(
+        pem("CERTIFICATE", &der).as_bytes(),
+        leaf.signing_key.serialize_pem().as_bytes(),
+        "server.crt",
+        "server.key",
+    );
+
+    let error = files.load().err().expect("require byte-aligned subject public key");
+    assert!(matches!(
+        error.kind(),
+        ServerErrorKind::Reason(reason) if reason == "subject public key BIT STRING is not aligned"
+    ));
+}
