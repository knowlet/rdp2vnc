+        "server.key",
+    );
+    fs::remove_file(&files.key_path).expect("remove key");
+    let error = files.load().err().expect("key path is missing");
+    assert_io_error(&error, "opening server key", io::ErrorKind::NotFound);
+    fs::remove_file(&files.cert_path).expect("remove certificate");
+    let error = files.load().err().expect("certificate path is missing");
+    assert_io_error(&error, "opening server cert", io::ErrorKind::NotFound);
+}
+
+#[cfg(unix)]
+#[test]
+fn legacy_read_errors_keep_the_underlying_io_kind() {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let files = IdentityFiles::new(
+        leaf.cert.pem().as_bytes(),
+        leaf.signing_key.serialize_pem().as_bytes(),
+        "server.crt",
+        "server.key",
+    );
+    fs::remove_file(&files.key_path).expect("remove key");
+    fs::create_dir(&files.key_path).expect("replace key with a directory");
+    let error = files.load().err().expect("cannot read a directory as a key");
+    assert_io_error(&error, "reading server key", io::ErrorKind::IsADirectory);
+    fs::remove_file(&files.cert_path).expect("remove certificate");
+    fs::create_dir(&files.cert_path).expect("replace certificate with a directory");
+    let error = files.load().err().expect("cannot read a directory as a certificate");
+    assert_io_error(&error, "collecting server cert", io::ErrorKind::IsADirectory);
+}
