@@ -0,0 +1,376 @@
+use core::time::Duration;
+use std::fs;
+use std::io;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use ironrdp_server::{ServerError, ServerErrorKind, ServerResult, TlsIdentityCtx};
+use rstest::rstest;
+use tokio_rustls::rustls::pki_types::PrivateKeyDer;
+use tokio_rustls::{TlsConnector, rustls};
+use x509_cert::der::asn1::BitString;
+use x509_cert::der::pem::{LineEnding, encode_string};
+use x509_cert::der::{Decode as _, Encode as _};
+
+struct IdentityFiles {
+    directory: PathBuf,
+    cert_path: PathBuf,
+    key_path: PathBuf,
+}
+
+impl IdentityFiles {
+    fn new(cert: &[u8], key: &[u8], cert_name: &str, key_name: &str) -> Self {
+        let directory = std::env::temp_dir().join(format!("ironrdp-server-helper-{}", uuid::Uuid::new_v4()));
+        fs::create_dir(&directory).expect("create temporary identity directory");
+        let files = Self {
+            cert_path: directory.join(cert_name),
+            key_path: directory.join(key_name),
+            directory,
+        };
+        fs::write(&files.cert_path, cert).expect("write temporary certificate");
+        fs::write(&files.key_path, key).expect("write temporary key");
+        files
+    }
+
+    fn load(&self) -> ServerResult<TlsIdentityCtx> {
+        TlsIdentityCtx::init_from_paths(&self.cert_path, &self.key_path)
+    }
+}
+
+impl Drop for IdentityFiles {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.directory);
+    }
+}
+
+fn pem(label: &str, der: &[u8]) -> String {
+    encode_string(label, LineEnding::LF, der).expect("encode test PEM block")
+}
+
+fn assert_io_error(error: &ServerError, context: &str, kind: io::ErrorKind) {
+    assert!(matches!(error.kind(), ServerErrorKind::Io(source) if source.kind() == kind));
+    assert!(error.to_string().starts_with(&format!("[{context}]")));
+}
+
+#[rstest]
+#[case("server.crt", "server.key")]
+#[case("server.pem", "server-key.pem")]
+#[case("server.der", "server-key.der")]
+#[case("server.PEM", "server-key.PEM")]
+#[case("certificate", "key")]
+fn certificate_chain_and_nla_public_key_are_preserved(#[case] cert_name: &str, #[case] key_name: &str) {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let other = rcgen::generate_simple_self_signed(vec!["other.example".into()]).expect("generate other cert");
+    let chain = format!(
+        "preamble\n{}{}{}{}",
+        leaf.cert.pem(),
+        leaf.signing_key.serialize_pem(),
+        pem("IGNORED", &[1, 2, 3]),
+        other.cert.pem(),
+    )
+    .replace('\n', "\r\n");
+    let files = IdentityFiles::new(
+        chain.as_bytes(),
+        leaf.signing_key.serialize_pem().replace('\n', "\r\n").as_bytes(),
+        cert_name,
+        key_name,
+    );
+
+    let identity = files.load().expect("load PEM identity");
+    assert_eq!(identity.certs, vec![leaf.cert.der().clone(), other.cert.der().clone()]);
+    assert!(matches!(identity.priv_key, PrivateKeyDer::Pkcs8(_)));
+    assert!(identity.priv_key.secret_der() == leaf.signing_key.serialize_der());
+    // NLA binds to the subjectPublicKey BIT STRING contents, excluding the SPKI wrapper.
+    assert_eq!(identity.pub_key, leaf.signing_key.public_key_raw());
+    identity.make_acceptor().expect("matching certificate and key");
+}
+
+#[rstest]
+#[case(&rustls::version::TLS12)]
+#[case(&rustls::version::TLS13)]
+#[tokio::test]
+async fn legacy_identity_completes_a_verified_tls_handshake(
+    #[case] version: &'static rustls::SupportedProtocolVersion,
+) {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let files = IdentityFiles::new(
+        leaf.cert.pem().as_bytes(),
+        leaf.signing_key.serialize_pem().as_bytes(),
+        "server.crt",
+        "server.key",
+    );
+    let identity = files.load().expect("load legacy identity");
+    let acceptor = identity.make_acceptor().expect("make TLS acceptor");
+    let mut roots = rustls::RootCertStore::empty();
+    roots.add(leaf.cert.der().clone()).expect("trust test certificate");
+    let config = rustls::ClientConfig::builder_with_protocol_versions(&[version])
+        .with_root_certificates(roots)
+        .with_no_client_auth();
+    let connector = TlsConnector::from(Arc::new(config));
+    let (client, server) = tokio::io::duplex(16384);
+    let server_name = rustls::pki_types::ServerName::try_from("localhost").expect("server name");
+    let (server, client) = tokio::time::timeout(Duration::from_secs(5), async {
+        tokio::join!(acceptor.accept(server), connector.connect(server_name, client))
+    })
+    .await
+    .expect("TLS handshake completes");
+    let server = server.expect("server TLS handshake");
+    let client = client.expect("client verifies certificate and handshake");
+    assert_eq!(server.get_ref().1.protocol_version(), Some(version.version));
+    assert_eq!(
+        client.get_ref().1.peer_certificates().expect("server certificates"),
+        identity.certs
+    );
+    assert_eq!(identity.pub_key, leaf.signing_key.public_key_raw());
+}
+
+#[test]
+fn legacy_key_path_selects_first_pkcs8_without_reading_the_tail() {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let other = rcgen::KeyPair::generate().expect("generate other key");
+    let keys = format!(
+        "{}{}{}{}{}{}{}-----BEGIN PRIVATE KEY-----\ninvalid base64!\n",
+        pem("RSA PRIVATE KEY", &[1]),
+        pem("EC PRIVATE KEY", &[2]),
+        pem("ENCRYPTED PRIVATE KEY", &[3]),
+        leaf.cert.pem(),
+        leaf.signing_key.serialize_pem(),
+        pem("EC PRIVATE KEY", &[4]),
+        other.serialize_pem(),
+    );
+    let files = IdentityFiles::new(leaf.cert.pem().as_bytes(), keys.as_bytes(), "server.crt", "server.key");
+
+    let identity = files.load().expect("load first PKCS#8 key");
+    assert!(matches!(identity.priv_key, PrivateKeyDer::Pkcs8(_)));
+    assert!(identity.priv_key.secret_der() == leaf.signing_key.serialize_der());
+    identity.make_acceptor().expect("first key matches certificate");
+}
+
+#[rstest]
+#[case("server.key", false)]
+#[case("server.pem", false)]
+#[case("server.key", true)]
+#[case("server.pem", true)]
+fn invalid_first_private_key_does_not_fall_back_to_a_later_key(#[case] key_name: &str, #[case] invalid_der: bool) {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let wrong_key = rcgen::KeyPair::generate().expect("generate wrong key");
+    let first_der = if invalid_der {
+        vec![1, 2, 3]
+    } else {
+        wrong_key.serialize_der()
+    };
+    let keys = format!("{}{}", pem("PRIVATE KEY", &first_der), leaf.signing_key.serialize_pem());
+    let files = IdentityFiles::new(leaf.cert.pem().as_bytes(), keys.as_bytes(), "server.crt", key_name);
+
+    let identity = files.load().expect("load first key");
+    assert!(identity.priv_key.secret_der() == first_der);
+    let error = identity.make_acceptor().err().expect("reject invalid first key");
+    assert!(matches!(error.kind(), ServerErrorKind::Custom));
+    assert!(error.to_string().starts_with("[bad certificate/key]"));
+}
+
+#[rstest]
+#[case("RSA PRIVATE KEY")]
+#[case("EC PRIVATE KEY")]
+#[case("ENCRYPTED PRIVATE KEY")]
+#[case("CERTIFICATE")]
+fn legacy_key_path_rejects_files_without_a_pkcs8_block(#[case] label: &str) {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let files = IdentityFiles::new(
+        leaf.cert.pem().as_bytes(),
+        pem(label, &[1, 2, 3]).as_bytes(),
+        "server.crt",
+        "server.key",
+    );
+
+    let error = files.load().err().expect("require a PKCS#8 block");
+    assert!(matches!(error.kind(), ServerErrorKind::Reason(reason) if reason == "no private key"));
+}
+
+#[test]
+fn pem_key_path_rejects_encrypted_keys() {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let files = IdentityFiles::new(
+        leaf.cert.pem().as_bytes(),
+        pem("ENCRYPTED PRIVATE KEY", &[1, 2, 3]).as_bytes(),
+        "server.pem",
+        "server.key.pem",
+    );
+
+    let error = files.load().err().expect("encrypted key is unsupported");
+    assert!(matches!(error.kind(), ServerErrorKind::Custom));
+    assert!(error.to_string().starts_with("[reading server key]"));
+}
+
+#[rstest]
+#[case("RSA PRIVATE KEY")]
+#[case("EC PRIVATE KEY")]
+#[case("PRIVATE KEY")]
+fn pem_key_path_keeps_its_existing_format_selection_and_key_validation(#[case] label: &str) {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    // The PEM reader selects by label; rustls must still reject invalid DER when building the acceptor.
+    let keys = format!("{}{}", pem(label, &[1, 2, 3]), leaf.signing_key.serialize_pem());
+    let files = IdentityFiles::new(
+        leaf.cert.pem().as_bytes(),
+        keys.as_bytes(),
+        "server.pem",
+        "server.key.pem",
+    );
+
+    let identity = files.load().expect("select first recognized PEM key");
+    assert!(matches!(
+        (&identity.priv_key, label),
+        (PrivateKeyDer::Pkcs1(_), "RSA PRIVATE KEY")
+            | (PrivateKeyDer::Sec1(_), "EC PRIVATE KEY")
+            | (PrivateKeyDer::Pkcs8(_), "PRIVATE KEY")
+    ));
+    assert!(identity.priv_key.secret_der() == [1, 2, 3]);
+    let error = identity.make_acceptor().err().expect("reject invalid selected key");
+    assert!(matches!(error.kind(), ServerErrorKind::Custom));
+    assert!(error.to_string().starts_with("[bad certificate/key]"));
+}
+
+#[rstest]
+#[case("-----BEGIN PRIVATE KEY-----\n!\n-----END PRIVATE KEY-----\n")]
+#[case("-----BEGIN PRIVATE KEY-----\nAQID\n")]
+fn malformed_legacy_key_is_an_invalid_data_error(#[case] key: &str) {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let files = IdentityFiles::new(leaf.cert.pem().as_bytes(), key.as_bytes(), "server.crt", "server.key");
+
+    let error = files.load().err().expect("reject malformed key");
+    assert_io_error(&error, "reading server key", io::ErrorKind::InvalidData);
+}
+
+#[rstest]
+#[case("-----BEGIN CERTIFICATE-----\n!\n-----END CERTIFICATE-----\n")]
+#[case("-----BEGIN CERTIFICATE-----\nAQID\n")]
+fn malformed_legacy_certificate_tail_is_an_invalid_data_error(#[case] tail: &str) {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    let certs = format!("{}{tail}", leaf.cert.pem());
