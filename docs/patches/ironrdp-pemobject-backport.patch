+#[test]
+fn empty_or_der_inputs_are_not_accepted_as_legacy_pem() {
+    let leaf = rcgen::generate_simple_self_signed(vec!["localhost".into()]).expect("generate leaf");
+    for key in [Vec::new(), leaf.signing_key.serialize_der()] {
